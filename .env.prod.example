# Copy to .env.prod and fill values before deploy
# cp .env.prod.example .env.prod

DEBUG=False

# REQUIRED
SECRET_KEY=replace-with-long-random-secret-key
ALLOWED_HOSTS=your-domain.com,www.your-domain.com

DB_HOST=db
DB_PORT=5432
DB_NAME=vybra
DB_USER=postgres
DB_PASSWORD=postgres

REDIS_URL=redis://redis:6379/0
DB_CONN_MAX_AGE=45
REDIS_CACHE_URL=redis://redis:6379/1
COMPARE_PRICE_TOLERANCE=0.10
COMPARE_PAIR_CACHE_TTL=20
PARSED_PRODUCT_CACHE_TTL=172800

# Google OAuth
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# HTTPS-only production flags
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
