# =============================================================
# .env — конфигурация Vybra
# =============================================================
# Заполните все поля, помеченные CHANGE_ME, перед запуском.
# Сгенерировать ключ: python -c "import secrets; print(secrets.token_urlsafe(50))"
# =============================================================

APP_NAME=vybra

# ─── Django ───────────────────────────────────────────────────────────────────
DEBUG=False
SECRET_KEY=CHANGE_ME_random_50_char_string
JWT_SECRET_KEY=CHANGE_ME_random_50_char_jwt_string
ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# ─── База данных PostgreSQL ───────────────────────────────────────────────────
DB_NAME=vybra          # менять вместе с APP_NAME (Docker Compose не раскрывает ${} внутри .env)
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_strong_db_password
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=60

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Email ───────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@example.com
EMAIL_HOST_PASSWORD=CHANGE_ME_smtp_password
DEFAULT_FROM_EMAIL=noreply@example.com

# ─── Google OAuth (опционально) ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── HTTPS / HSTS ─────────────────────────────────────────────────────────────
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# ─── Логирование ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=WARNING

# ─── Настройки приложения ─────────────────────────────────────────────────────
COMPARE_PRICE_TOLERANCE=0.10
COMPARE_PAIR_CACHE_TTL=20
PARSED_PRODUCT_CACHE_TTL=172800

# ─── Деплой-скрипты ───────────────────────────────────────────────────────────
DOMAIN=your-domain.com
WWW_DOMAIN=www.your-domain.com
CERTBOT_EMAIL=admin@your-domain.com
CERTBOT_WEBROOT=/var/www/certbot
APP_UPSTREAM=127.0.0.1:8000
NGINX_CONF_PATH=/etc/nginx/sites-available/${APP_NAME}.conf
NGINX_ENABLED_PATH=/etc/nginx/sites-enabled/${APP_NAME}.conf
PRIMARY_COMPOSE_FILE=docker-compose.yml
SECONDARY_COMPOSE_FILE=docker-compose.prod.yml
BACKUP_DIR=./backups
BACKUP_KEEP=5
DB_CONTAINER_USER=postgres
DB_CONTAINER_NAME=${APP_NAME}
