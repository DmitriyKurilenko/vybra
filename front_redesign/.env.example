# Доставка — single-origin: фронт собирается и отдаётся тем же Django-сервером,
# поэтому базовый URL API пустой (запросы идут на тот же origin: /api/...).
VITE_API_URL=

# Встроенный офлайн-мок (in-memory + localStorage), без бэкенда.
# По умолчанию выключен — приложение ходит в реальный API.
# Поставь true, чтобы открыть UI без сервера (демо).
VITE_USE_MOCK=false
