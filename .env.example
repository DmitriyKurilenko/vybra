# =============================================================
# .env — конфигурация окружения
# =============================================================
# Заполните все поля, помеченные CHANGE_ME, перед запуском.
# Сгенерировать ключ: python -c "import secrets; print(secrets.token_urlsafe(50))"
# =============================================================

# ─── Django ───────────────────────────────────────────────────────────────────
DEBUG=False
SECRET_KEY=CHANGE_ME
JWT_SECRET_KEY=CHANGE_ME
ALLOWED_HOSTS=localhost,127.0.0.1,vybra.prvms.ru

# ─── База данных PostgreSQL ───────────────────────────────────────────────────
DB_NAME=vybra
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=60

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Email (опционально) ────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@vybra.app

# ─── Google OAuth (опционально) ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── HTTPS / HSTS ─────────────────────────────────────────────────────────────
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# ─── Логирование ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=WARNING

# ─── Настройки приложения ─────────────────────────────────────────────────────
COMPARE_PRICE_TOLERANCE=0.10
COMPARE_PAIR_CACHE_TTL=20
PARSED_PRODUCT_CACHE_TTL=172800

# ─── Celery / Wildberries recovery (опционально) ─────────────────────────────
WB_NIGHTLY_RECOVERY_ENABLED=true
WB_NIGHTLY_RECOVERY_CRON_HOUR=0-6
WB_NIGHTLY_RECOVERY_CRON_MINUTE=*/20
WB_NIGHTLY_RECOVERY_BATCH_SIZE=20
WB_NIGHTLY_RECOVERY_RETRIES=3
WB_NIGHTLY_RECOVERY_TIMEOUT=35
WB_NIGHTLY_RECOVERY_COOLDOWN_HOURS=20

# ─── Парсеры ──────────────────────────────────────────────────────────────────
WB_SELENIUM_FALLBACK_TIMEOUT=20
WB_SELENIUM_FALLBACK_RETRIES=1
WB_BATCH_PARSE_RETRIES=2
WB_BATCH_PARSE_TIMEOUT=25
SELENIUM_HEADLESS=True
TASK_PROGRESS_STEP=10
IMPORT_FAVORITES_DELAY_SEC=0.2

# ─── Traefik / Reverse Proxy ──────────────────────────────────────────────────
TRAEFIK_HOST=vybra.prvms.ru

# ─── Деплой ───────────────────────────────────────────────────────────────────
COMPOSE_FILE=docker-compose.prod.yml
BACKUP_DIR=./backups
BACKUP_KEEP=5
